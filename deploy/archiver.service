[Unit]
Description=WhatsApp Archiver
After=network-online.target
Wants=network-online.target
[Service]
Type=notify
WatchdogSec=120
User=whatsapp-archiver
Group=whatsapp-archiver
WorkingDirectory=/opt/whatsapp-archiver
ExecStart=/opt/whatsapp-archiver/archiver run --data /var/lib/whatsapp-archiver
Restart=always
RestartSec=5
RestartPreventExitStatus=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/var/lib/whatsapp-archiver /srv/backups/whatsapp-archiver
[Install]
WantedBy=multi-user.target
